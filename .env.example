# Robinhood Chain mainnet RPC. Server-side only, never in the client bundle.
# The public endpoint works and is the only one that serves eth_getLogs for
# chain 4663 — it rate-limits hard, which is why the scan is a pipeline and not
# a page render.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Canonical origin, used for metadata and share cards.
NEXT_PUBLIC_SITE_URL=https://thegraveyard.xyz

# Durable waitlist sink. When empty, nothing is stored and the form says so
# rather than pretending it saved something.
WAITLIST_WEBHOOK_URL=

# The gate. Unset or anything other than "1" keeps the whole site behind the
# waitlist; middleware bounces every other route to the front door. Set to 1 to
# open the scan, the dataset, the docs and the archive.
PUBLIC_SITE_OPEN=
